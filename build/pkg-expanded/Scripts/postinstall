#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=install-common.sh
source "${SCRIPT_DIR}/install-common.sh"

_init_install_log "postinstall" "$@"

APP="Odoo Database Manager.app"
TARGET="/Applications/${APP}"

app_ok() {
  [[ -f "${1}/Contents/Info.plist" ]]
}

PKG_PATH=""
TARGET_ROOT="/"
if [[ "${1:-}" == *.pkg ]] || [[ "${1:-}" == *.mpkg ]]; then
  PKG_PATH="${1}"
  TARGET_ROOT="${2:-/}"
  install_log "Paquet: ${PKG_PATH}"
else
  TARGET_ROOT="${1:-/}"
fi
TARGET_ROOT="${TARGET_ROOT%/}"
[[ -z "$TARGET_ROOT" ]] && TARGET_ROOT="/"
install_log "Racine cible: ${TARGET_ROOT}"

if app_ok "$TARGET"; then
  install_log "OK : ${TARGET} déjà en place."
  exit 0
fi

CANDIDATES=(
  "/Applications/${APP}"
  "${TARGET_ROOT}/Applications/${APP}"
)

install_log "Recherche du bundle (extraction installateur)…"
FOUND=""
for SRC in "${CANDIDATES[@]}"; do
  [[ "$SRC" == "//Applications/"* ]] && continue
  install_log "  teste: ${SRC}"
  if app_ok "$SRC"; then
    FOUND="$SRC"
    install_log "  trouvé: ${SRC}"
    break
  fi
done

if [[ -z "$FOUND" ]]; then
  RECEIPT_PLIST="$(pkgutil --only-files com.odoo.dbmanager 2>/dev/null | grep -F "${APP}/Contents/Info.plist" | head -1 || true)"
  if [[ -n "$RECEIPT_PLIST" ]]; then
    RECEIPT_APP="${RECEIPT_PLIST%/Contents/Info.plist}"
    install_log "Receipt: ${RECEIPT_APP}"
    if app_ok "$RECEIPT_APP"; then
      FOUND="$RECEIPT_APP"
    fi
  fi
fi

if [[ -z "$FOUND" && -n "$PKG_PATH" ]]; then
  install_log "L'installateur n'a pas posé le bundle — installation depuis le .pkg…"
  install_extract_from_pkg "$PKG_PATH" "$APP" "$TARGET"
  FOUND="$TARGET"
fi

if [[ -z "$FOUND" ]]; then
  install_log "Contenu de /Applications (diagnostic) :"
  /bin/ls -la /Applications 2>&1 | _install_write || true
  install_fail "${APP} introuvable et extraction depuis le .pkg impossible."
fi

if [[ "$FOUND" != "$TARGET" ]]; then
  install_log "Copie ${FOUND} → ${TARGET}"
  install_run "suppression ancienne cible" /bin/rm -rf "$TARGET"
  install_run "copie du bundle (ditto)" /usr/bin/ditto "$FOUND" "$TARGET"
fi

if ! app_ok "$TARGET"; then
  install_fail "Échec final : ${TARGET}/Contents/Info.plist absent."
fi

install_run "permissions lecture" /bin/chmod -R a+rX "$TARGET"

install_log "Installation réussie : ${TARGET}"
exit 0
