#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=install-common.sh
source "${SCRIPT_DIR}/install-common.sh"

_init_install_log "postinstall" "$@"

APP="Odoo Database Manager.app"
TARGET="/Applications/${APP}"

app_ok() {
  [[ -f "${1}/Contents/Info.plist" ]]
}

# macOS peut passer le chemin du .pkg en $1 (ex. ~/Downloads/xxx.pkg), pas le volume.
# $2 = racine du volume cible (souvent /), $3 = répertoire d'install ou /.
PKG_PATH=""
TARGET_ROOT="/"
if [[ "${1:-}" == *.pkg ]] || [[ "${1:-}" == *.mpkg ]]; then
  PKG_PATH="${1}"
  TARGET_ROOT="${2:-/}"
  install_log "Paquet: ${PKG_PATH}"
else
  TARGET_ROOT="${1:-/}"
fi
TARGET_ROOT="${TARGET_ROOT%/}"
[[ -z "$TARGET_ROOT" ]] && TARGET_ROOT="/"

install_log "Racine cible: ${TARGET_ROOT} (arg2=${2:-?} arg3=${3:-?})"

# Chemins possibles (toujours /Applications en premier)
CANDIDATES=(
  "/Applications/${APP}"
  "${TARGET_ROOT}/Applications/${APP}"
)
if [[ -n "${3:-}" && "${3}" != "/" && "${3}" != "${TARGET_ROOT}" ]]; then
  CAND3="${3%/}"
  CANDIDATES+=("${CAND3}/${APP}")
  CANDIDATES+=("${CAND3}/Applications/${APP}")
fi

# Dédupliquer
declare -a UNIQUE=()
for c in "${CANDIDATES[@]}"; do
  skip=0
  for u in "${UNIQUE[@]}"; do
    [[ "$c" == "$u" ]] && skip=1 && break
  done
  [[ $skip -eq 0 ]] && UNIQUE+=("$c")
done

install_log "Recherche du bundle installé…"
FOUND=""
for SRC in "${UNIQUE[@]}"; do
  install_log "  teste: ${SRC}"
  if app_ok "$SRC"; then
    FOUND="$SRC"
    install_log "  trouvé: ${SRC}"
    break
  fi
done

if [[ -z "$FOUND" ]]; then
  RECEIPT_PLIST="$(pkgutil --only-files com.odoo.dbmanager 2>/dev/null | grep -F "${APP}/Contents/Info.plist" | head -1 || true)"
  if [[ -n "$RECEIPT_PLIST" ]]; then
    RECEIPT_APP="${RECEIPT_PLIST%/Contents/Info.plist}"
    install_log "Bundle repéré via le receipt: ${RECEIPT_APP}"
    if app_ok "$RECEIPT_APP"; then
      FOUND="$RECEIPT_APP"
    fi
  fi
fi

if [[ -z "$FOUND" ]]; then
  install_log "Contenu de /Applications (diagnostic) :"
  ls -la /Applications 2>&1 | _install_write || true
  install_log "Chemins testés sans succès :"
  printf '  - %s\n' "${UNIQUE[@]}" | _install_write
  install_fail "${APP} introuvable. Le payload n'a pas été extrait dans /Applications."
fi

if [[ "$FOUND" != "$TARGET" ]]; then
  install_log "Copie ${FOUND} → ${TARGET}"
  install_run "suppression ancienne cible" rm -rf "$TARGET"
  install_run "copie du bundle (ditto)" ditto "$FOUND" "$TARGET"
else
  install_log "Bundle déjà à la cible ${TARGET}."
fi

if ! app_ok "$TARGET"; then
  install_fail "Copie terminée mais ${TARGET}/Contents/Info.plist est absent."
fi

install_run "permissions lecture" chmod -R a+rX "$TARGET"

install_log "Installation réussie : ${TARGET}"
exit 0
